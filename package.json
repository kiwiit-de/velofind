{
  "name": "velofind-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "test:postgres": "tsx tests/postgres-connection.test.ts",
    "test:kysely": "tsx tests/kysely-repositories.test.ts",
    "test:monitoring": "tsx tests/phase29-monitoring.test.ts",
    "test": "tsx tests/postgres-connection.test.ts && tsx tests/kysely-repositories.test.ts && tsx tests/mvp-verification.test.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "compose:prod": "docker compose --env-file .env.production -f compose.production.yml up -d",
    "compose:prod:down": "docker compose --env-file .env.production -f compose.production.yml down",
    "compose:prod:logs": "docker compose --env-file .env.production -f compose.production.yml logs -f",
    "compose:prod:backup": "docker compose --env-file .env.production -f compose.production.yml --profile backup run --rm db-backup",
    "test:compose": "tsx tests/compose-production.test.ts",
    "test:caddy": "tsx tests/caddy-production.test.ts",
    "test:backup": "tsx tests/backup-automation.test.ts",
    "test:restore": "tsx tests/restore-drill.test.ts",
    "test": "tsx tests/postgres-connection.test.ts && tsx tests/kysely-repositories.test.ts && tsx tests/mvp-verification.test.ts && tsx tests/compose-production.test.ts && tsx tests/caddy-production.test.ts && tsx tests/backup-automation.test.ts && tsx tests/restore-drill.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.22",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "kysely": "^0.29.5",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "yaml": "^2.9.0"
  }
}
