# ==============================================================================
# VeloFind Production Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env.production' on your target server:
#    cp .env.production.example .env.production
# 2. Generate a cryptographically secure password for POSTGRES_PASSWORD:
#    openssl rand -base64 32
# 3. Restrict file permissions immediately:
#    chmod 600 .env.production
# 4. NEVER commit the actual '.env.production' to version control.
# ==============================================================================

# Node.js Application Runtime
NODE_ENV=production
PORT=3000
APP_URL=https://velofind.de
CANONICAL_HOST=velofind.de

# TLS & Reverse Proxy (Caddy / Let's Encrypt)
ACME_EMAIL=admin@velofind.de

# PostgreSQL 17 Database Credentials (internal private network only)
POSTGRES_DB=velofind_db
POSTGRES_USER=velofind
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_GENERATED_PASSWORD_MIN_32_CHARS
DATABASE_URL=postgresql://velofind:REPLACE_WITH_STRONG_GENERATED_PASSWORD_MIN_32_CHARS@postgres:5432/velofind_db

# Connection Pool Tuning
POSTGRES_MAX_CONNECTIONS=20
PGIDLE_TIMEOUT_MS=30000
PGCONNECT_TIMEOUT_MS=5000

# Flyway Database Migration Engine
FLYWAY_CONNECT_RETRIES=60

# Automated Database Backup Settings
BACKUP_PATH=/backups
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=14
BACKUP_ENCRYPTION_KEY_PATH=
BACKUP_REMOTE_DESTINATION=
